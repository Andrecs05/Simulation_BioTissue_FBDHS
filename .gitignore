# ---------------------------------------------------------------
# LAMMPS heavy outputs (dumps, trajectories, restarts, logs)
# ---------------------------------------------------------------
dump.*
*.dump
*.lammpstrj
*.dcd
*.xtc
*.restart
restart.*
*.rst
log.lammps
log.*.lammps

# LAMMPS data files (generated configurations, ~2 MB each)
DPD tissue/**/*.data

# Per-frame thermo / MSD / COM outputs written by fix ave/time
DPD tissue/**/runs/**/*.dat

# Compressed trajectories built from the dumps (~100 MB each)
traj*.npz
DPD tissue/**/runs/**/*.npz

# ...except the ones DHS instrument/code/per_surface_analysis.ipynb loads
!DPD tissue/code/runs/cell_[0-3]/traj.npz
!DPD tissue/code/layout.npz

# Whole run folders generated by make_runs.py on Apolo
DPD tissue/for_apolo/*/runs/
DPD tissue/for_apolo/*/results/**/*.npy

# SLURM job output
slurm-*.out
slurm-*.err
