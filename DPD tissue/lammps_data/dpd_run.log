# ---------------------- 8. Production run with tracer trajectory dump --------
reset_timestep 0

# N=1 -> every timestep; lower this (e.g. every 10-50 steps) if you only
# need a coarser sampling rate for your target Doppler/Nyquist bandwidth.
dump         traj tracers custom 1 tracer_positions.dump id type x y z vx vy vz
dump_modify  traj sort id

run          20000
