# ==========================================================================
# LAMMPS DPD prototype: multi-species dissipative particle dynamics
# in a 3D periodic box (Groot & Warren 1997 reduced-unit conventions,
# consistent with the Basan et al. 2011 DPD tissue framework).
#
# Particle types (LAMMPS atom types):
#   type 1 = bulk medium / extracellular-matrix-like DPD fluid  (majority)
#   type 2 = "particle of interest" A -- slow/heavy tracer
#            (e.g. mitochondrion-like: larger mass & repulsion radius,
#             higher friction -> low mobility)
#   type 3 = "particle of interest" B -- fast/light tracer
#            (e.g. vesicle-like: smaller mass, lower friction -> high mobility)
#
# Types 2 and 3 are dumped at high time resolution so their trajectories
# can be post-processed in Python (MSD, velocity autocorrelation, Doppler
# power spectrum S(omega)) independently of the bulk medium.
# ==========================================================================

# ---------------------- 1. Initialization --------------------------------
units        lj
dimension    3
boundary     p p p
atom_style   atomic
neighbor     0.3 bin
neigh_modify every 1 delay 0 check yes    # DPD particles move fast -> reneighbor often
comm_modify  vel yes                      # required: dpd force needs ghost-atom velocities

# ---------------------- 2. Simulation box ---------------------------------
variable     L equal 10.0                 # box edge length (reduced units)
region       simbox block 0 ${L} 0 ${L} 0 ${L} units box
region       simbox block 0 10 0 ${L} 0 ${L} units box
region       simbox block 0 10 0 10 0 ${L} units box
region       simbox block 0 10 0 10 0 10 units box
create_box   3 simbox
Created orthogonal box = (0 0 0) to (10 10 10)
  1 by 1 by 1 MPI processor grid

# ---------------------- 3. Populate box with particles --------------------
variable     rho    equal 3.0             # Groot-Warren reference density
variable     Nbulk  equal round(${rho}*${L}*${L}*${L})
variable     Nbulk  equal round(3*${L}*${L}*${L})
variable     Nbulk  equal round(3*10*${L}*${L})
variable     Nbulk  equal round(3*10*10*${L})
variable     Nbulk  equal round(3*10*10*10)
variable     Ntrace equal 60              # tracers per "particle of interest" species

create_atoms 1 random ${Nbulk}  12345 simbox     # bulk medium
create_atoms 1 random 3000  12345 simbox     
Created 3000 atoms
  using lattice units in orthogonal box = (0 0 0) to (10 10 10)
  create_atoms CPU = 0.001 seconds
create_atoms 2 random ${Ntrace} 22233 simbox     # organelle "A" (slow/heavy)
create_atoms 2 random 60 22233 simbox     
Created 60 atoms
  using lattice units in orthogonal box = (0 0 0) to (10 10 10)
  create_atoms CPU = 0.000 seconds
create_atoms 3 random ${Ntrace} 88711 simbox     # organelle "B" (fast/light)
create_atoms 3 random 60 88711 simbox     
Created 60 atoms
  using lattice units in orthogonal box = (0 0 0) to (10 10 10)
  create_atoms CPU = 0.000 seconds

group        medium  type 1
3000 atoms in group medium
group        orgA    type 2
60 atoms in group orgA
group        orgB    type 3
60 atoms in group orgB
group        tracers union orgA orgB
120 atoms in group tracers

# ---------------------- 4. Masses ------------------------------------------
mass  1  1.0     # medium particle (reference mass)
mass  2  5.0     # heavier organelle -> lower mobility
mass  3  1.5     # lighter organelle -> higher mobility

# ---------------------- 5. Pair style: DPD ----------------------------------
# pair_style dpd T cutoff seed
variable     T  equal 1.0
variable     rc equal 1.0
pair_style   dpd ${T} ${rc} 98765
pair_style   dpd 1 ${rc} 98765
pair_style   dpd 1 1 98765

#              A(repulsion)  gamma(friction)  cutoff
pair_coeff   1 1   25.0          4.5            ${rc}   # medium-medium
pair_coeff   1 1   25.0          4.5            1   
pair_coeff   1 2   20.0          3.0            1.3     # medium-orgA (larger reach)
pair_coeff   1 3   25.0          4.5            1.0     # medium-orgB
pair_coeff   2 2   15.0          2.0            1.5     # orgA-orgA (soft, allows crowding)
pair_coeff   2 3   20.0          3.0            1.2     # orgA-orgB cross term
pair_coeff   3 3   25.0          4.5            1.0     # orgB-orgB

# ---------------------- 6. Time integration ---------------------------------
timestep     0.01
fix          integrate all nve
# LAMMPS docs recommend fix mvv/dpd over nve for better DPD accuracy:
# unfix      integrate
# fix        integrate all mvv/dpd

# ---------------------- 7. Diagnostics ---------------------------------------
compute      msdA orgA msd
compute      msdB orgB msd
thermo_style custom step temp press pe ke c_msdA[4] c_msdB[4]
thermo       500

# Equilibrate the bulk medium before recording tracer trajectories
run          2000
