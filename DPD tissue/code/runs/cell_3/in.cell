units         lj
atom_style    bond
boundary      p p p
comm_modify   vel yes cutoff 5.5
neighbor      0.3 bin
neigh_modify  every 1 delay 0 check yes
read_data     cell.data

pair_style    dpd 1.0 1.0 34417
pair_coeff    1 1 25.0 4.5
pair_coeff    1 2 50.0 4.5   # cytoplasm-membrane
pair_coeff    2 2 30.0 4.5
pair_coeff    2 3 30.0 4.5
pair_coeff    2 4 30.0 4.5
pair_coeff    2 5 30.0 4.5
pair_coeff    1 3 40.0 4.5   # cytoplasm-nucleus
pair_coeff    3 3 30.0 4.5
pair_coeff    3 4 30.0 4.5
pair_coeff    3 5 30.0 4.5
pair_coeff    1 4 40.0 4.5   # cytoplasm-mitochondrion
pair_coeff    4 4 30.0 4.5
pair_coeff    4 5 30.0 4.5
pair_coeff    1 5 35.0 4.5   # cytoplasm-vesicle
pair_coeff    5 5 30.0 4.5
pair_coeff    1 6 25.0 4.5   # cytoplasm-medium
pair_coeff    6 6 25.0 4.5
pair_coeff    2 6 50.0 4.5   # membrane-medium
pair_coeff    3 6 40.0 4.5   # nucleus-medium
pair_coeff    4 6 40.0 4.5   # mitochondrion-medium
pair_coeff    5 6 35.0 4.5   # vesicle-medium

bond_style    harmonic
bond_coeff    1 100.0 0.5
bond_coeff    2 100.0 0.7071

group         cyto type 1
group         org type 3 4 5
group         mobile type 1 2 6
group         membrane type 2
group         nucleus type 3
group         mitochondrion type 4
group         vesicle type 5
group         dumped union membrane org
neigh_modify  exclude molecule/intra org

velocity      mobile create 1.0 34418 mom yes rot no
fix           fluid mobile nve
fix           bodies org rigid/small molecule

compute       chunks org chunk/atom molecule
compute       msd org msd/chunk chunks
fix           msdout org ave/time 167 1 167 c_msd[4] file msd_org.dat mode vector

timestep      0.01
thermo        1670
dump          traj dumped custom 167 dump.cell id mol type x y z ix iy iz
run           310620
