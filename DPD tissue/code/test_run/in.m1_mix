units         lj
atom_style    bond
boundary      p p p
comm_modify   vel yes cutoff 5.5
neighbor      0.3 bin
neigh_modify  every 1 delay 0 check yes
read_data     m1_mix.data

pair_style    dpd 1.0 1.0 34387
pair_coeff    1 1 25.0 4.5
pair_coeff    1 2 40.0 4.5   # cytoplasm-mitochondrion
pair_coeff    2 2 30.0 4.5
pair_coeff    2 3 30.0 4.5
pair_coeff    1 3 35.0 4.5   # cytoplasm-vesicle
pair_coeff    3 3 30.0 4.5

group         cyto type 1
group         org type 2 3
group         mitochondrion type 2
group         vesicle type 3
neigh_modify  exclude molecule/intra org

velocity      cyto create 1.0 4928459 mom yes rot no
fix           fluid cyto nve
fix           bodies org rigid/small molecule

compute       chunks org chunk/atom molecule
compute       msd org msd/chunk chunks
fix           msdout org ave/time 100 1 100 c_msd[4] file msd_org.dat mode vector

timestep      0.01
thermo        1000
dump          traj all custom 1000 dump.m1_mix id mol type x y z ix iy iz
run           200000
