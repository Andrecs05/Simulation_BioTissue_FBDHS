#Simulation box
region       simbox block 0 ${L} 0 ${L} 0 ${L} units box
region       simbox block 0 10 0 ${L} 0 ${L} units box
region       simbox block 0 10 0 10 0 ${L} units box
region       simbox block 0 10 0 10 0 10 units box
create_box   2 simbox
Created orthogonal box = (0 0 0) to (10 10 10)
  1 by 1 by 1 MPI processor grid

comm_modify vel yes

print "Starting run ${Ntrace} at simulation time $(time)"
Starting run 29 at simulation time 0

#Populate box with medium
variable     Nbulk  equal round(${rho}*${L}*${L}*${L})
variable     Nbulk  equal round(3*${L}*${L}*${L})
variable     Nbulk  equal round(3*10*${L}*${L})
variable     Nbulk  equal round(3*10*10*${L})
variable     Nbulk  equal round(3*10*10*10)
create_atoms 1 random ${Nbulk}  12345 simbox     # bulk medium
create_atoms 1 random 3000  12345 simbox     
Created 3000 atoms
  using lattice units in orthogonal box = (0 0 0) to (10 10 10)
  create_atoms CPU = 0.000 seconds
group        medium  type 1
3000 atoms in group medium


create_atoms 2 random ${Ntrace} 22233 simbox     # organelle "A" (slow/heavy)
create_atoms 2 random 29 22233 simbox     
Created 29 atoms
  using lattice units in orthogonal box = (0 0 0) to (10 10 10)
  create_atoms CPU = 0.000 seconds

group        orgA    type 2
29 atoms in group orgA
group        tracers  union orgA
29 atoms in group tracers

mass  1  1.0     # medium particle (reference mass)
mass  2  3.0     # lighter organelle -> higher mobility

#  Pair style: DPD
pair_style   dpd ${T} ${rc} 98765
pair_style   dpd 1 ${rc} 98765
pair_style   dpd 1 1 98765

#              A(repulsion)  gamma(friction)  cutoff
pair_coeff   1 1   25.0          4.5            ${rc}   # medium-medium
pair_coeff   1 1   25.0          4.5            1   
pair_coeff   1 2   20.0          3.0            1.3     # medium-orgA (larger reach)
pair_coeff   2 2   15.0          2.0            1.5     # orgA-orgA (soft, allows crowding)


#Time integration
timestep     0.01
fix          integrate all nve



compute      msdA_${Ntrace} orgA msd
compute      msdA_29 orgA msd
thermo_style custom step temp press pe ke c_msdA_${Ntrace}[4]
thermo_style custom step temp press pe ke c_msdA_29[4]
thermo       500


dump         traj tracers custom 1 tracer_positions_${Ntrace}.dump id type x y z vx vy vz
dump         traj tracers custom 1 tracer_positions_29.dump id type x y z vx vy vz
dump_modify  traj sort id

